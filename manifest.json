{
  "manifest_version": 3,
  "name": "AZRecorder - OAuth2.0/OpenID Connect Authorization Request/Response Recorder",
  "version": "1.0.0",
  "description": "Collects and displays OAuth2.0/OpenID Connect authorization requests and responses for analysis",

  "permissions": [
    "activeTab",
    "storage",
    "history",
    "webNavigation",
    "debugger"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AZRecorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
